<!-- The ids Google gives the app, all in one place.

     admob_app_id: AdMob → Apps → Ice Dash → App settings, "App ID"
       (ca-app-pub-…~…). Google's test app id is ca-app-pub-3940256099942544~3347511713.
       The rewarded ad unit (ca-app-pub-…/…) goes in js/native.js, AD_UNIT.
     game_services_project_id: Play Console → Play Games Services →
       Setup and management → Configuration, the project id (digits only).
     leaderboard_freeride: Play Games Services → Leaderboards → Freeride,
       the leaderboard id (CgkI…).
     While the last two are empty the app has no board and shows no button
     for one (PlayGamesPlugin.java). -->
<resources>
    <string name="admob_app_id" translatable="false">ca-app-pub-6104904420104536~8263726642</string>
    <string name="game_services_project_id" translatable="false">378437852809</string>
    <string name="leaderboard_freeride" translatable="false">CgkIib2d5YELEAIQAQ</string>
    <!-- leaderboard_cards: Play Games Services → Leaderboards → Cards, each
         player's newest profile card (PlayGamesPlugin.java, `cards`) -->
    <string name="leaderboard_cards" translatable="false">CgkIib2d5YELEAIQAg</string>
    <!-- play_server_client_id (1.3.5): the shared board's server (server/).
         Google Cloud project of Play Games → Credentials → OAuth client
         "Web application", added in Play Console → Play Games Services →
         Configuration → Credentials as a "Game server". Its id ends in
         .apps.googleusercontent.com; its secret is the Worker's
         GOOGLE_CLIENT_SECRET, never here. Empty: no shared board on Android. -->
    <string name="play_server_client_id" translatable="false">378437852809-cbr9hvjake0u4mi56ss1teu6c3nncnm0.apps.googleusercontent.com</string>
